{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "kind": {
      "const": "AuthoritativeReadbackContract"
    },
    "object_hash": {
      "pattern": "^[0-9A-F]{64}$",
      "type": "string"
    },
    "source_level_required": {
      "enum": [
        "AUTHORITATIVE_REPOSITORY",
        "PROVIDER_VALIDATION",
        "PROVIDER_LOG",
        "TRANSPORT_SUCCESS",
        "CACHED_OUTPUT",
        "LOCAL_RUNNER_STATE",
        "INFERRED_OR_REGEX"
      ]
    }
  },
  "required": [
    "kind",
    "object_hash",
    "contract_id",
    "source_level_required",
    "provider_ref",
    "checks"
  ],
  "title": "AuthoritativeReadbackContract",
  "type": "object"
}
