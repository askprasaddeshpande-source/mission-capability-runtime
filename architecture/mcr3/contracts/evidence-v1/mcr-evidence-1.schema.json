  "required": [
    "contract",
    "contract_version",
    "id",
    "type",
    "source",
    "time",
    "producer",
    "correlation",
    "claim",
    "evidence",
    "authority_effect",
    "digests",
    "lineage"
  ],
  "title": "MCR Evidence Contract v1 (version-independent canonical evidence envelope)",
  "type": "object"
}
